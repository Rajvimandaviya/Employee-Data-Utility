        /* =====================================
           9. FOOTER
        ===================================== */

        footer {
            padding: 20px 10px;
            color: #64748b;
            text-align: center;
            font-size: 13px;
        }

        footer strong {
            color: #4f46e5;
        }

        /* =====================================
           10. RESPONSIVE DESIGN
        ===================================== */

        @media (max-width: 900px) {
            body {
                padding: 20px;
            }

            .stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .stat-card:last-child {
                grid-column: 1 / -1;
            }
        }

        @media (max-width: 600px) {
            body {
                padding: 12px;
