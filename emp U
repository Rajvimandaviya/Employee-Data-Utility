    </style>
</head>

<body>

<div class="container">

    <!-- STEP 1: PROJECT HEADER -->
    <header>
        <div class="header-content">
            <span class="header-label">EMPLOYEE MANAGEMENT SYSTEM</span>
            <h1>Employee Data Utility</h1>
            <p>Employee Records • Salary Analysis • Department Management</p>
        </div>
    </header>

    <!-- STEP 2: EMPLOYEE SUMMARY CARDS -->
    <section class="stats">

        <div class="stat-card">
            <div class="stat-label">Total Employees Displayed</div>
            <strong class="stat-number" id="totalEmployees">0</strong>
        </div>

        <div class="stat-card">
            <div class="stat-label">Average Salary</div>
            <strong class="stat-number" id="averageSalary">₹0</strong>
        </div>

        <div class="stat-card">
            <div class="stat-label">Highest Paid Employee</div>
            <strong class="stat-number" id="highestEmployee">-</strong>
        </div>

    </section>

    <!-- STEP 3: FILTER AND SORT CONTROLS -->
    <section class="card">

        <h2 class="section-title">Employee Filters</h2>
        <p class="section-description">
            Filter employees by department and salary, sort records, or group departments.
        </p>

        <div class="controls-grid">

            <div class="control-group">
                <label for="department">Filter by Department</label>
                <select id="department">
                    <option value="">All Departments</option>
                    <option value="IT">IT</option>
                    <option value="HR">HR</option>
                    <option value="Finance">Finance</option>
                    <option value="Marketing">Marketing</option>
                    <option value="Sales">Sales</option>
                </select>
            </div>

            <div class="control-group">
                <label>Salary Range (₹)</label>
                <div class="salary-inputs">
                    <input type="number" id="minSalary"
                        placeholder="Minimum salary" min="0">
                    <input type="number" id="maxSalary"
                        placeholder="Maximum salary" min="0">
                </div>
            </div>

            <div class="control-group">
                <label for="sortBy">Sort Employee Records</label>
                <select id="sortBy">
                    <option value="">Default Order</option>
                    <option value="nameAsc">Name (A to Z)</option>
                    <option value="nameDesc">Name (Z to A)</option>
                    <option value="salaryAsc">Salary (Low to High)</option>
                    <option value="salaryDesc">Salary (High to Low)</option>
                </select>
            </div>

            <div class="control-group">
                <label for="groupBy">Group by Department</label>
                <select id="groupBy">
                    <option value="no">No Grouping</option>
                    <option value="yes">Group Departments</option>
                </select>
            </div>

        </div>

        <div class="button-row">
            <button type="button" id="applyBtn">Apply Filters</button>
            <button type="button" id="resetBtn" class="reset">Reset All</button>
        </div>

    </section>

    <!-- STEP 4: RESULT MESSAGE -->
    <section class="card">

        <h2 class="section-title">Employee Records</h2>
        <p class="section-description">
            View employee IDs, names, departments and salary details.
        </p>

        <p id="message" aria-live="polite">Loading employees...</p>

        <!-- STEP 5: EMPLOYEE TABLE -->
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Employee ID</th>
                        <th>Employee Name</th>
                        <th>Department</th>
                        <th>Salary (₹)</th>
                    </tr>
                </thead>

                <tbody id="employeeTable"></tbody>
            </table>
        </div>

    </section>

    <!-- STEP 6: FOOTER -->
    <footer>
        Employee Data Utility | Built with <strong>HTML, CSS and JavaScript</strong>
    </footer>

</div>

<script>
    // ============================================
    // STEP 1: CREATE SAMPLE EMPLOYEE DATA
    // ============================================

    // Store 25 sample employees in an array of objects.
    // Each employee has an ID, name, department and salary.

    const employees = [
        { id: 1, name: "Aarav Patel", department: "IT", salary: 45000 },
        { id: 2, name: "Diya Shah", department: "HR", salary: 32000 },
        { id: 3, name: "Rohan Mehta", department: "Finance", salary: 50000 },
        { id: 4, name: "Anaya Desai", department: "Marketing", salary: 35000 },
        { id: 5, name: "Krish Joshi", department: "Sales", salary: 28000 },
        { id: 6, name: "Mira Trivedi", department: "IT", salary: 60000 },
        { id: 7, name: "Dev Patel", department: "HR", salary: 30000 },
        { id: 8, name: "Isha Shah", department: "Finance", salary: 55000 },
        { id: 9, name: "Yash Mehta", department: "Marketing", salary: 40000 },
        { id: 10, name: "Kiara Desai", department: "Sales", salary: 33000 },
        { id: 11, name: "Arjun Joshi", department: "IT", salary: 52000 },
        { id: 12, name: "Nisha Patel", department: "HR", salary: 38000 },
        { id: 13, name: "Vivaan Shah", department: "Finance", salary: 65000 },
        { id: 14, name: "Pooja Mehta", department: "Marketing", salary: 42000 },
        { id: 15, name: "Dhruv Desai", department: "Sales", salary: 36000 },
        { id: 16, name: "Riya Joshi", department: "IT", salary: 70000 },
        { id: 17, name: "Neel Trivedi", department: "HR", salary: 34000 },
        { id: 18, name: "Kavya Patel", department: "Finance", salary: 48000 },
        { id: 19, name: "Om Shah", department: "Marketing", salary: 31000 },
        { id: 20, name: "Tara Mehta", department: "Sales", salary: 44000 },
        { id: 21, name: "Reyansh Desai", department: "IT", salary: 58000 },
        { id: 22, name: "Aditi Joshi", department: "HR", salary: 41000 },
        { id: 23, name: "Parth Patel", department: "Finance", salary: 75000 },
        { id: 24, name: "Myra Shah", department: "Marketing", salary: 39000 },
        { id: 25, name: "Kabir Mehta", department: "Sales", salary: 47000 }
    ];

    // ============================================
    // STEP 2: SELECT HTML ELEMENTS
    // ============================================

    // Connect JavaScript to the HTML controls.

    const departmentInput = document.getElementById("department");
    const minSalaryInput = document.getElementById("minSalary");
    const maxSalaryInput = document.getElementById("maxSalary");
    const sortInput = document.getElementById("sortBy");
    const groupInput = document.getElementById("groupBy");
    const tableBody = document.getElementById("employeeTable");

    // ============================================
    // STEP 3: FILTER AND SORT EMPLOYEES
    // ============================================

    function applyFilters() {

        // Read the selected filter options.
        const department = departmentInput.value;
        const minValue = minSalaryInput.value;
        const maxValue = maxSalaryInput.value;
        const sortValue = sortInput.value;

        // Convert entered salary values into numbers.
        // Empty fields remain null, meaning no salary limit.

        const minSalary = minValue === "" ? null : Number(minValue);
        const maxSalary = maxValue === "" ? null : Number(maxValue);

        // Prevent negative salary limits.

        if (
            (minSalary !== null && minSalary < 0) ||
            (maxSalary !== null && maxSalary < 0)
        ) {
            alert("Salary cannot be negative.");
            return;
        }

        // Prevent the minimum salary from exceeding the maximum.

        if (
            minSalary !== null &&
            maxSalary !== null &&
            minSalary > maxSalary
        ) {
            alert("Minimum salary cannot exceed maximum salary.");
            return;
        }

        // Filter by department and salary range.

        let filteredEmployees = employees.filter(function(employee) {

            const matchesDepartment =
                department === "" ||
                employee.department === department;

            const matchesMinSalary =
                minSalary === null ||
                employee.salary >= minSalary;

            const matchesMaxSalary =
                maxSalary === null ||
                employee.salary <= maxSalary;

            return matchesDepartment &&
                   matchesMinSalary &&
                   matchesMaxSalary;
        });

        // Sort the matching employees according to the selected option.

        if (sortValue === "nameAsc") {

            filteredEmployees.sort(function(a, b) {
                return a.name.localeCompare(b.name);
            });

        } else if (sortValue === "nameDesc") {

            filteredEmployees.sort(function(a, b) {
                return b.name.localeCompare(a.name);
            });

        } else if (sortValue === "salaryAsc") {

            filteredEmployees.sort(function(a, b) {
                return a.salary - b.salary;
            });

        } else if (sortValue === "salaryDesc") {

            filteredEmployees.sort(function(a, b) {
                return b.salary - a.salary;
            });
        }

        // Display the filtered records and update the summary.
        displayEmployees(filteredEmployees);
        updateSummary(filteredEmployees);
    }

    // ============================================
    // STEP 4: FORMAT SALARY
    // ============================================

    // Format numbers in Indian currency style.

    function formatSalary(amount) {
        return "₹" + amount.toLocaleString("en-IN");
    }

    // ============================================
    // STEP 5: CREATE EMPLOYEE TABLE ROWS
    // ============================================

    function addEmployeeRow(employee) {

        // Create a new row for the employee.
        const row = document.createElement("tr");

        // Prepare the four column values.
        const values = [
            employee.id,
            employee.name,
            employee.department,
            formatSalary(employee.salary)
        ];

        values.forEach(function(value, index) {

            const cell = document.createElement("td");

            // Use textContent to safely display each value.
            cell.textContent = value;

            // Add visual styling to ID, department and salary.
            if (index === 0) {
                cell.className = "employee-id";
            }

            if (index === 2) {
                const badge = document.createElement("span");
                badge.className = "department-badge " +
                    employee.department.toLowerCase();
                badge.textContent = employee.department;

                cell.textContent = "";
                cell.appendChild(badge);
            }

            if (index === 3) {
                cell.className = "salary";
            }

            row.appendChild(cell);
        });

        // Insert the row into the table.
        tableBody.appendChild(row);
    }

    // ============================================
    // STEP 6: DISPLAY EMPLOYEE RECORDS
    // ============================================

    function displayEmployees(list) {

        // Clear old rows before displaying new results.
        tableBody.innerHTML = "";

        // Display a helpful message when no records match.
        if (list.length === 0) {

            const row = document.createElement("tr");
            const cell = document.createElement("td");

            cell.colSpan = 4;
            cell.className = "empty-cell";
            cell.textContent = "No employees found. Try different filters.";

            row.appendChild(cell);
            tableBody.appendChild(row);

            return;
        }

        // Group employees by department if grouping is enabled.
        if (groupInput.value === "yes") {

            const departments = [
                "Finance",
                "HR",
                "IT",
                "Marketing",
                "Sales"
            ];

            departments.forEach(function(dept) {

                // Find employees belonging to this department.
                const departmentEmployees = list.filter(function(employee) {
                    return employee.department === dept;
                });

                if (departmentEmployees.length > 0) {

                    // Add a department heading row.
                    const headingRow = document.createElement("tr");
                    headingRow.className = "department-heading";

                    const headingCell = document.createElement("th");
                    headingCell.colSpan = 4;

                    headingCell.textContent =
                        dept + " Department (" +
                        departmentEmployees.length + " employees)";

                    headingRow.appendChild(headingCell);
                    tableBody.appendChild(headingRow);

                    // Display this department's employee records.
                    departmentEmployees.forEach(addEmployeeRow);
                }
            });

        } else {

            // Display records without department headings.
            list.forEach(addEmployeeRow);
        }
    }

    // ============================================
    // STEP 7: CALCULATE EMPLOYEE STATISTICS
    // ============================================

    function updateSummary(list) {

        // Update the total number of matching employees.
        document.getElementById("totalEmployees").textContent = list.length;

        // Handle an empty result.
        if (list.length === 0) {

            document.getElementById("averageSalary").textContent = "₹0";
            document.getElementById("highestEmployee").textContent = "-";
            document.getElementById("message").textContent =
                "No matching employees.";

            return;
        }

        // Calculate the sum of all matching salaries.
        const totalSalary = list.reduce(function(total, employee) {
            return total + employee.salary;
        }, 0);

        // Calculate the average salary.
        const averageSalary = totalSalary / list.length;

        // Find the highest-paid employee.
        const highestEmployee = list.reduce(function(highest, employee) {
            return employee.salary > highest.salary ? employee : highest;
        });

        // Display the calculated statistics.
        document.getElementById("averageSalary").textContent =
            formatSalary(Math.round(averageSalary));

        document.getElementById("highestEmployee").textContent =
            highestEmployee.name + " (" +
            formatSalary(highestEmployee.salary) + ")";

        // Explain how many records are currently displayed.
        document.getElementById("message").textContent =
            "Showing " + list.length +
            " of " + employees.length + " employees.";
    }

    // ============================================
    // STEP 8: RESET ALL OPTIONS
    // ============================================

    function resetAll() {

        // Restore every control to its default value.
        departmentInput.value = "";
        minSalaryInput.value = "";
        maxSalaryInput.value = "";
        sortInput.value = "";
        groupInput.value = "no";

        // Display all 25 employees again.
        applyFilters();
    }

    // ============================================
    // STEP 9: ADD BUTTON EVENT LISTENERS
    // ============================================

    // Apply the selected filters when clicked.
    document.getElementById("applyBtn").addEventListener(
        "click",
        applyFilters
    );

    // Reset all filters and show every employee.
    document.getElementById("resetBtn").addEventListener(
        "click",
        resetAll
    );

    // ============================================
    // STEP 10: INITIALIZE THE EMPLOYEE TABLE
    // ============================================

    // Display all 25 employees when the page opens.
    applyFilters();

</script>

</body>
</html>
