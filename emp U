            header {
                padding: 25px 20px;
                border-radius: 16px;
            }

            .stats,
            .controls-grid {
                grid-template-columns: 1fr;
            }

            .stat-card:last-child {
                grid-column: auto;
            }

            .card,
            .stat-card {
                padding: 18px;
                border-radius: 13px;
